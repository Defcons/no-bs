+    @PluginMethod()
+    public void getBufferedLocations(PluginCall call) {
+        if (service == null) {
+            call.reject("Service not running.");
+            return;
+        }
+        String id = call.getString("id");
+        if (id == null) {
+            call.reject("Missing id.");
+            return;
+        }
+        JSArray locations = new JSArray();
+        for (android.location.Location loc : service.drainBuffer(id)) {
+            locations.put(formatLocation(loc));
+        }
+        JSObject ret = new JSObject();
+        ret.put("locations", locations);
