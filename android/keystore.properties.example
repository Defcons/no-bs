# Release signing for the Play Store upload key. Copy this to `keystore.properties`
# (which is gitignored) and fill in your values, then build the AAB with:
#   cd android && ./gradlew bundleRelease   (Windows: gradlew.bat bundleRelease)
#
# Generate the keystore first (keep upload-keystore.jks + these passwords SAFE and
# BACKED UP — losing them means you can't ship updates under this app):
#   keytool -genkey -v -keystore android/upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile is resolved relative to the android/ project dir.
storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
