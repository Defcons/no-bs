# R8 rules for the release build (minifyEnabled true in build.gradle).
#
# Already covered, no rule needed here:
#  - Capacitor core ships consumer rules that keep every @CapacitorPlugin class, its
#    @PluginMethod / @PermissionCallback / @ActivityCallback / @Permission members and every
#    class extending com.getcapacitor.Plugin, so our own plugins (Pip, HwButtons, StepCounter,
#    WorkoutService) and every plugin in package.json stay callable by name from JS.
#  - The manifest's activity, services and provider (MainActivity, WorkoutService,
#    BackgroundGeolocationService, and on the extended flavour VolumeKeyAccessibilityService)
#    get keep rules generated by AAPT2.
# Plugin libraries do not ship consumer rules for their own reflection, so those are below.

# Capacitor reads @CapacitorPlugin(name = ...), @PluginMethod and the permission annotations
# by reflection; Signature/InnerClasses keep generic and nested types readable to it.
-keepattributes *Annotation*, Signature, InnerClasses, EnclosingMethod

# Play's deobfuscation file (mapping.txt) turns a minified crash trace back into source lines.
-keepattributes SourceFile, LineNumberTable
-renamesourcefileattribute SourceFile

# Capacitor core in full. With the consumer rules alone R8 dropped PluginHandle's cached
# @CapacitorPlugin annotation and Bridge.getPermissionStates threw a NullPointerException
# at the first LocalNotifications.requestPermissions call (emulator, Android 15). The core
# reads annotations, fields and methods by reflection (PluginHandle, Bridge, MessageHandler,
# the WebView JS bridge), and it is a small part of the dex, so it keeps its names.
-keep class com.getcapacitor.** { *; }

# The WebView JS bridge: the JS side calls the annotated methods by name.
-keepclassmembers class * {
    @android.webkit.JavascriptInterface <methods>;
}

# Our plugins and services, named explicitly. The Plugin and manifest rules above already
# cover them, but a rename here would break the JS side silently, so say it in the app's own file.
# (VolumeKeyAccessibilityService exists only in the extended flavour; a rule for a class that
# is absent from a build is ignored.)
-keep class no.defc0n.gymtracker.MainActivity { *; }
-keep class no.defc0n.gymtracker.*Plugin { *; }
-keep class no.defc0n.gymtracker.WorkoutService { *; }
-keep class no.defc0n.gymtracker.VolumeKeyAccessibilityService { *; }

# @capgo/capacitor-updater: its own proguard-rules.pro keeps its package (it reflects into
# Capacitor's Bridge and PluginCall, covered by the com.getcapacitor rule above); Gradle does
# not apply a library's own rules to the app.
-keep class ee.forgr.capacitor_updater.** { *; }

# Cordova bridge classes (capacitor-cordova-android-plugins), loaded by name from config.xml.
-keep public class * extends org.apache.cordova.CordovaPlugin { public <methods>; public <fields>; }
