<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- allowBackup=false: users back up via the explicit .xlsx/JSON export; Android
         auto-backup of WebView/IndexedDB + Capgo bundle prefs restores stale state
         onto new devices (Capgo prefs then point at bundles that don't exist). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- The background-geolocation plugin ships its FGS as exported=true (any app
             could start/bind our location service). It's only ever bound in-process —
             lock it down. -->
        <service
            android:name="com.equimaps.capacitor_background_geolocation.BackgroundGeolocationService"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:exported" />

        <!-- Workout foreground service (standard build, earbud break on): keeps the app
             alive on a locked phone. Type "health" = fitness tracking; on Android 14+ it
             needs ACTIVITY_RECOGNITION granted (WorkoutServicePlugin checks first). Ends
             with the task, so swiping the app away also drops its notification. -->
        <service
            android:name=".WorkoutService"
            android:exported="false"
            android:foregroundServiceType="health"
            android:stopWithTask="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bluetooth LE (heart rate) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Location — GPS run tracking + leave-gym auto-end. Both run through the
         location-type FOREGROUND service, started while the app is open, so plain
         "While using the app" permission keeps GPS flowing with the screen off.
         Deliberately NO ACCESS_BACKGROUND_LOCATION: it isn't needed for this
         pattern, and it's the highest-rejection-rate permission on Play (declaration
         + demo video + "core functionality" review). Do not re-add casually. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- The workout foreground service (WorkoutService), type health. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <!-- Notifications (break-timer alarm + reminders) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- On-time rest-over alarm. User-granted "Alarms & reminders" (Settings asks when the
         break notification is turned on); refused, the plugin falls back to an inexact
         alarm. NOT USE_EXACT_ALARM: Play keeps that auto-granted kind for alarm-clock apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Hardware step counter (workout step stats). Runtime-requested on Android 10+. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
</manifest>
